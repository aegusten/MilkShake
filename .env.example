# Copy this file to .env and fill in real values for your environment.
# The .env file is gitignored.

# --- Postgres (inside the docker-compose network) ---
POSTGRES_DB=milkshake
POSTGRES_USER=milkshake
POSTGRES_PASSWORD=change-me-locally
POSTGRES_SERVER=db
POSTGRES_PORT=5432

# --- JWT (admin auth) ---
# Min 32 chars. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-long-random-string-at-least-32-chars
JWT_ALGORITHM=HS256
# Access token lifetime. 480 minutes = 8 hours (one staff shift).
JWT_ACCESS_TTL_MINUTES=480

# --- CORS ---
# Comma-separated list of allowed origins (no trailing slashes).
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:5174
