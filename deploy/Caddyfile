# Caddy terminates HTTPS and gets the certificate itself: a real one from
# Let's Encrypt for a public DOMAIN, a locally trusted one for "localhost".
{
	http_port {$HTTP_PORT:80}
	https_port {$HTTPS_PORT:443}
}

{$DOMAIN:localhost} {
	# The web server already gzips, and must never compress event streams,
	# so Caddy only proxies. Streaming responses are flushed as they come.
	reverse_proxy web:3000
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}
